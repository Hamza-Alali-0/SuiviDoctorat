// ============================================
// PREMIUM ENCADRANT DASHBOARD
// Theme aligned with candidate `profile` page (neutral, compact, blue accent)
// ============================================

// Color Palette (profile-aligned)
$brand-blue: #2563eb; // --blue-600
$brand-blue-700: #1d4ed8; // --blue-700
$muted-ink: #0f172a; // zinc-900
$muted-2: #475569; // zinc-700
$muted-3: #94a3b8; // zinc-400
$surface: #ffffff;
$surface-2: #f8fafc;
$page-bg: #fafafa; // page background
$border-color: #e2e8f0;

// Gradients (subtle)
$gradient-blue: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
$gradient-green: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
$gradient-purple: linear-gradient(135deg, #e9d5ff 0%, #d8b4fe 100%);

// Main Container
.dashboard-premium {
  min-height: 100vh;
  background: $page-bg;
}

// ============================================
// HERO HEADER - Blue Gradient Banner
// ============================================
.hero-header-premium {
  position: relative;
  background: transparent;
  padding: 1.5rem 1.25rem;
  border-bottom: 1px solid $border-color;
  overflow: visible;

  .hero-content-premium {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .hero-text { flex: 1; }

  .hero-label { font-size: 0.75rem; font-weight:700; text-transform:uppercase; color: $brand-blue; margin-bottom: 0.35rem }

  .hero-title { font-size: 1.6rem; font-weight:700; color: $text-dark; margin: 0 0 0.25rem 0 }

  .hero-welcome { font-size: 0.95rem; color: $muted-2; margin: 0 }

  .hero-date-card {
    background: $surface;
    border-radius: 10px;
    padding: 0.5rem 0.75rem;
    display:flex; align-items:center; gap:0.5rem; border:1px solid $border-color;
  }
}

// ============================================
// MAIN CONTENT
// ============================================
.dashboard-content-premium {
  max-width: 1600px;
  margin: 0 auto;
  padding: 3rem;
  display: grid;
  gap: 3rem;
}

// ============================================
// STATISTICS CARDS - Profile-aligned
// ============================================
.stats-grid-premium {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 1rem;
}

.stat-card-premium {
  background: $surface;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(2,6,23,0.05);
  transition: transform .15s ease, box-shadow .15s ease;
  position: relative;
  border: 1px solid $border-color;

  &:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(2,6,23,0.06); }

  .stat-gradient-bar { height: 6px; background: $brand-blue; border-radius:4px }
  .stat-content { padding: 1rem }

  .stat-header-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:0.6rem }
  .stat-label { font-size:0.7rem; font-weight:600; color:$muted-2; text-transform:uppercase }
  .stat-badge { font-size:0.75rem; padding:6px 10px; border-radius:9999px; background:$surface-2; color:$brand-blue; font-weight:700 }

  .stat-number { font-size:0.95rem; font-weight:700; color:$text-dark; margin-bottom:6px }
  .stat-footer { font-size:0.875rem; color:$muted-2 }
}

// ============================================
// MAIN GRID LAYOUT (profile-style)
// ============================================
.main-grid-premium {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 2rem;

  @media (max-width: 1200px) { grid-template-columns: 1fr; }
}

// Section Cards
.section-card-premium {
  background: #fff;
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: 0 4px 20px rgba(2,6,23,0.06);
  border: 1px solid $border-color;
}

.section-header-premium {
  display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:0.75rem; border-bottom:1px solid $border-color;

  .section-title-premium { font-size:1.125rem; font-weight:700; color:$text-dark; margin:0 }
  .section-count { font-size:0.8125rem; font-weight:700; color:$muted-2; padding:6px 10px; background:$surface-2; border-radius:9999px }

  .btn-view-all-premium { background:transparent; border:1px solid $border-color; color:$muted-2; padding:0.5rem 0.9rem; border-radius:12px; font-weight:700; font-size:0.85rem }
}

// ============================================
// ACTIVITY TIMELINE
// ============================================
.activity-timeline {
  display: grid;
  gap: 0;
}

.activity-item-premium {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 1.5rem;
  padding: 1.5rem 0;
  border-bottom: 1px solid $border-color;
  transition: all 0.3s ease;

  &:last-child {
    border-bottom: none;
  }

  &:hover {
    background: linear-gradient(90deg, rgba(59, 130, 246, 0.03) 0%, transparent 100%);
    padding-left: 1rem;
    padding-right: 1rem;
    margin-left: -1rem;
    margin-right: -1rem;
  }

  .activity-indicator {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    margin-top: 6px;
    flex-shrink: 0;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);

    &.status-soumise {
      background: $gradient-blue;
    }

    &.status-en_verification {
      background: $gradient-purple;
    }

    &.status-prerequis_valides {
      background: $gradient-green;
    }

    &.status-jury_propose {
      background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
    }

    &.status-autorisee,
    &.status-planifiee {
      background: $gradient-teal;
    }

    &.status-terminee {
      background: $gradient-green;
    }

    &.status-brouillon {
      background: linear-gradient(135deg, #9CA3AF 0%, #6B7280 100%);
    }
  }

  .activity-details {
    flex: 1;
    min-width: 0;
  }

  .activity-doctorant {
    font-size: 1rem;
    font-weight: 700;
    color: $text-dark;
    margin-bottom: 0.375rem;
  }

  .activity-action {
    font-size: 0.875rem;
    color: $text-medium;
    margin-bottom: 0.5rem;
  }

  .activity-timestamp {
    font-size: 0.8125rem;
    color: $text-light;
    font-weight: 500;
  }

  .activity-status-pill {
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
    align-self: center;

    &.pill-soumise {
      background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
      color: #1E40AF;
    }

    &.pill-en_verification {
      background: linear-gradient(135deg, #E9D5FF 0%, #D8B4FE 100%);
      color: #6B21A8;
    }

    &.pill-prerequis_valides {
      background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
      color: #065F46;
    }

    &.pill-jury_propose {
      background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
      color: #92400E;
    }

    &.pill-autorisee,
    &.pill-planifiee {
      background: $gradient-teal;
      color: white;
    }

    &.pill-terminee {
      background: $gradient-green;
      color: white;
    }

    &.pill-brouillon {
      background: linear-gradient(135deg, #E5E7EB 0%, #D1D5DB 100%);
      color: #4B5563;
    }
  }
}

// ============================================
// DEMANDES GRID
// ============================================
.demandes-grid-premium { display:grid; grid-template-columns: repeat(auto-fill,minmax(300px,1fr)); gap:1rem }

.demande-card-premium {
  background: $surface; border:1px solid $border-color; border-radius:14px; overflow:hidden; cursor:pointer; transition: transform .12s ease, box-shadow .12s ease; position:relative;

  &:hover { transform: translateY(-4px); box-shadow:0 8px 24px rgba(2,6,23,0.06); border-color: rgba(37,99,235,0.12) }

  .demande-gradient-line { position:absolute; left:0; top:0; width:4px; height:100%; transition:width .2s ease; background:$surface-2 }

  .demande-header-premium { padding: 12px 14px; display:flex; justify-content:space-between; align-items:center }
  .demande-number { font-size:0.72rem; font-weight:800; color:$muted-3; text-transform:uppercase }
  .demande-status-badge { padding:6px 10px; border-radius:9999px; font-size:0.72rem; font-weight:700; color:$muted-ink; background:$surface-2 }
  .demande-body-premium { padding: 0 14px 12px }
  .demande-title-premium { font-size:1rem; font-weight:700; color:$text-dark; margin:0 0 8px }
  .demande-info-row { display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid $border-color }
  .info-label { font-weight:600; color:$muted-3 } .info-value { font-weight:600; color:$text-dark; text-align:right }
  .demande-footer-premium { padding:10px 14px; background:transparent; text-align:right }
  .view-link { font-size:0.9rem; font-weight:700; color:$brand-blue; transition:transform .12s ease; display:inline-block }
}
*** End Patch